{
  "expo": {
    "name": "Ministry",
    "slug": "ministry",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ministry",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alext.ministry"
    },
    "android": {
      "package": "com.alext.ministry"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
