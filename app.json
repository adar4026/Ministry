{
  "expo": {
    "name": "Ministry",
    "slug": "ministry",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ministry",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alext.ministry"
    },
    "android": {
      "package": "com.alext.ministry",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ministry использует доступ к фотографиям, чтобы установить фото профиля."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Ministry"
    }
  }
}
